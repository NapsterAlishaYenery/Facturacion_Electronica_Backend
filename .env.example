PORT=4001
NODE_ENV=development

# Base de datos PostgreSQL
DB_HOST=hot_de_la_base_de_datos
DB_PORT=puerto_db
DB_NAME=name_db
DB_USER=User_db
DB_PASSWORD=password_db

# DGII (lo llenamos después)
DGII_ENV=testecf
DGII_RNC=

# Certificado (lo llenamos cuando llegue)
CERT_PATH=./certs/certificado.p12
CERT_PASSWORD=

# Varibales Para JsonWebToken
# Generar estos codigos aleatorios
# EN BASH: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=tu_secreto_muy_largo_y_aleatorio_aqui_min_32_chars
JWT_REFRESH_SECRET=otro_secreto_diferente_tambien_largo
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
COOKIE_SECRET=otro_secreto_para_firmar_cookies

# ============================================================
# Jobs programados (cron)
# ============================================================
# true  → arranca el scheduler al iniciar el server
# false → no arranca (útil en desarrollo para no tocar datos)
ENABLE_JOBS=false

# Zona horaria para las expresiones cron
JOBS_TIMEZONE=America/Santo_Domingo

# ============================================================
# URL
# ============================================================
# URL del frontend (ya deberías tenerlo, pero lo referencio porque
# se usará para construir links de reset password)
FRONTEND_URL=http://localhost:4200


# ============================================================
# Notifications (email)
# ============================================================
# Host SMTP (ej: smtp.gmail.com, smtp.sendgrid.net, smtp-relay.brevo.com)
SMTP_HOST=smtp.example.com
SMTP_PORT=587

# Credenciales SMTP
SMTP_USER=tu_usuario_smtp
SMTP_PASS=tu_password_o_api_key
REGISTRATION_NOTIFY_EMAIL=tu_email
# Remitente por defecto (formato: "Nombre <email@dominio.com>")
SMTP_FROM="Facturación Electrónica <no-reply@tudominio.com>"
